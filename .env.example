# Copy to .env and fill in what you have. Every value has a safe fallback,
# so the demo runs with zero config -- these just upgrade fidelity.

# --- LLM provider: ollama (default, local/free) | anthropic | mock ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embeddings: sentence-transformers (default, needs internet once to pull
# the model) | tfidf (fully offline fallback, no download, used automatically
# in tests) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=.chroma

# --- Zendesk: leave blank to run against data/sample_tickets.json instead ---
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- Tuning ---
# Defaults below assume the sentence-transformers backend, whose cosine
# similarities run higher than TF-IDF's. If you switch EMBEDDING_BACKEND=tfidf,
# use the lower thresholds documented in tests/test_pipeline.py (~0.16 / 0.60 /
# 0.30) instead, or re-tune either against your own KB with `python evaluate.py`.
TOP_K=3
RETRIEVAL_CONFIDENCE_FLOOR=0.28
GROUNDEDNESS_AUTO_SUGGEST=0.70
GROUNDEDNESS_NEEDS_REVIEW=0.40
